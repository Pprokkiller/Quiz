# =============================================
# QuizVerse — Backend Environment Variables
# =============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# =============================================


# ----------------------------------------
# DATABASE
# ----------------------------------------
# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# If using Supabase: copy from Project Settings → Database → Connection String (URI)
# -----------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE


# ----------------------------------------
# JWT
# ----------------------------------------
# Secret key used to sign and verify JSON Web Tokens.
# Use a long random string — at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_here


# ----------------------------------------
# SERVER PORT
# ----------------------------------------
# The port the Express server listens on.
# Default is 5000 if not set.
# -----------------------------------------------------------------------
PORT=5000
